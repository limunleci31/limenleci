            <!-- Mobile Brand Bar & Action Toggle -->
            <div class="w-full md:w-auto flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 cursor-pointer min-w-0" onclick="filterByTab('all')">
                    <div class="w-10 h-10 md:w-12 md:h-12 bg-black text-[#FFE600] rounded-xl border-2 border-black flex items-center justify-center p-1.5 shrink-0 shadow-[2px_2px_0px_#000]">
                        <svg class="w-full h-full text-[#FFE600]" viewBox="0 0 64 64" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="52" width="56" height="5" rx="1"/>
                            <rect x="12" y="24" width="8" height="28" rx="1"/>
                            <rect x="44" y="24" width="8" height="28" rx="1"/>
                            <path d="M8 24 C20 10, 44 10, 56 24 C46 16, 18 16, 8 24 Z"/>
                            <path d="M26 18 L32 6 L38 18 Z"/>
                            <circle cx="32" cy="11" r="2.5"/>
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h1 class="text-lg md:text-2xl font-grotesk font-black text-black leading-none tracking-tight truncate">
                                Tugas TPB
                            </h1>
                            <span class="text-[#FFE600] bg-black px-1.5 py-0.5 rounded border border-black font-mono font-extrabold text-[10px] md:text-xs shrink-0">
                                ITERA 73
