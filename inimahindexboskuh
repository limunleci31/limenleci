                        <span class="hidden md:inline">UNGGAH</span>
                    </button>
                </div>
            </div>

            <!-- Desktop Top Controls Bar -->
            <div class="hidden md:flex items-center gap-2 flex-wrap justify-end shrink-0">
                <div id="header-sync-status" class="brutal-badge bg-black text-[#FFE600] px-3 py-1.5 text-[11px] flex items-center gap-2 cursor-pointer hover:bg-slate-800" onclick="openShareModal()">
