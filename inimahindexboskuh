                        </div>
                        <p class="text-[10px] md:text-xs font-bold text-black/80 truncate mt-0.5">
                            Realtime Sync Multi-Device Dashboard
                        </p>
                    </div>
                </div>

                <!-- Role Selector (Mobile/Desktop Right) -->
                <div class="flex items-center gap-2 shrink-0">
                    <div class="bg-white border-2 border-black rounded-xl p-1 flex items-center shadow-[2px_2px_0px_#000]">
                        <button id="role-btn-student" onclick="setRole('student')" class="px-2 py-1.5 md:px-3 rounded-lg text-[10px] md:text-xs font-extrabold transition-colors bg-black text-white flex items-center gap-1.5">
