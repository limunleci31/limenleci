    <script>
        // --- REALTIME SYNC CORE UPGRADE --- //
        
        // 1. Setup Identifier untuk Sync Antar Perangkat Pribadi (Cross-Device Progress)
        let studentId = localStorage.getItem('tpb73_student_id');
        if (!studentId) {
            studentId = 'MHS-' + Math.floor(1000 + Math.random() * 9000);
            localStorage.setItem('tpb73_student_id', studentId);
        }
        document.getElementById('input-student-id').value = studentId;
        document.getElementById('desktop-user-id').innerText = studentId;
        document.getElementById('mobile-user-id').innerText = studentId;

        const DEFAULT_FIREBASE_CONFIG = {
            // Gunakan project Dummy, atau user diwajibkan set manual
            apiKey: "AIzaSyB3XvY1Z2A3B4C5D6E7F8G9H0I1J2K3L4M",
            authDomain: "tpb73-itera.firebaseapp.com",
            databaseURL: "https://tpb73-itera-default-rtdb.asia-southeast1.firebasedatabase.app", 
            projectId: "tpb73-itera"
        };

        const INITIAL_MOCK_TASKS = [
            {
                id: 'task-1', type: 'assignment', title: 'Laporan Topik 3', course: 'Fisika Dasar II',
                pjName: 'Rian', deadline: new Date(Date.now() + 18000000).toISOString(), priority: 'HIGH', desc: 'Format PDF.'
            },
            {
                id: 'task-2', type: 'assignment', title: 'Tugas Latihan Integral', course: 'Kalkulus II',
                pjName: 'Anisa', deadline: new Date(Date.now() + 172800000).toISOString(), priority: 'MEDIUM', desc: 'Kerjakan Soal Bab 14.'
            }
        ];

        let tasks = [];
        let personalTurnIns = {};
        let currentRole = 'student';
        let currentTab = 'all';
        let formType = 'assignment';
        let isWidgetMode = false;

        let firebaseDb = null;
        let isCloudConnected = false;
        let tasksListenerRef = null;
        let progressListenerRef = null;
        let currentRoomId = localStorage.getItem('tpb73_room_id') || 'tpb73_itera_2026';

        window.addEventListener('DOMContentLoaded', () => {
            loadTasksFromStorage();
            loadPersonalTurnIns();
            initRealtimeFirebaseSync();
            renderDashboard();
            setInterval(updateLiveClockAndStatus, 1000);
            lucide.createIcons();
        });

        // 2. Tab Synchronization (Realtime antar Tab di Device yang sama tanpa perlu Firebase jalan)
        window.addEventListener('storage', (e) => {
            if (e.key === 'tpb73_tasks_v2' || e.key === 'tpb73_personal_turnins' || e.key === 'tpb73_student_id') {
                studentId = localStorage.getItem('tpb73_student_id') || studentId;
                document.getElementById('desktop-user-id').innerText = studentId;
                document.getElementById('mobile-user-id').innerText = studentId;
                
                loadTasksFromStorage();
                loadPersonalTurnIns();
                renderDashboard(true);
            }
        });

        function saveStudentId() {
            const newVal = document.getElementById('input-student-id').value.trim();
            if (newVal) {
                studentId = newVal;
                localStorage.setItem('tpb73_student_id', studentId);
                document.getElementById('desktop-user-id').innerText = studentId;
                document.getElementById('mobile-user-id').innerText = studentId;
                initRealtimeFirebaseSync(); // Restart listener with new ID
                showToast(`✅ ID Mahasiswa diubah ke: ${studentId}`);
            }
        }

        function initRealtimeFirebaseSync() {
            let activeConfig = DEFAULT_FIREBASE_CONFIG;
            const savedCustomConfig = localStorage.getItem('tpb73_firebase_config');
            if (savedCustomConfig) {
                try { activeConfig = JSON.parse(savedCustomConfig); } catch(e) {}
            }

            if (typeof firebase !== 'undefined') {
                try {
                    if (!firebase.apps.length) firebase.initializeApp(activeConfig);
                    firebaseDb = firebase.database();
                    document.getElementById('current-room-tag').innerText = currentRoomId;

                    // Sync 1: Class Tasks
                    if (tasksListenerRef) tasksListenerRef.off();
                    tasksListenerRef = firebaseDb.ref(`classes/${currentRoomId}/tasks`);
                    tasksListenerRef.on('value', (snapshot) => {
                        const cloudTasks = snapshot.val();
                        if (cloudTasks && Array.isArray(cloudTasks)) {
                            tasks = cloudTasks;
                            localStorage.setItem('tpb73_tasks_v2', JSON.stringify(tasks));
                            renderDashboard(true);
                        }
                    }, () => updateCloudBadgeUI(false));

                    // Sync 2: Personal Progress based on Student ID
                    if (progressListenerRef) progressListenerRef.off();
                    progressListenerRef = firebaseDb.ref(`classes/${currentRoomId}/students/${studentId}/progress`);
                    progressListenerRef.on('value', (snapshot) => {
                        const cloudProgress = snapshot.val();
                        if (cloudProgress) {
                            personalTurnIns = cloudProgress;
                            localStorage.setItem('tpb73_personal_turnins', JSON.stringify(personalTurnIns));
                            renderDashboard(false);
                        }
                    });

                    isCloudConnected = true;
                    updateCloudBadgeUI(true);

                } catch(err) {
                    console.error("Firebase Initialization Error:", err);
                    isCloudConnected = false;
                    updateCloudBadgeUI(false);
                }
            } else {
                updateCloudBadgeUI(false);
            }
        }

        function pushTasksToCloud() {
            localStorage.setItem('tpb73_tasks_v2', JSON.stringify(tasks));
            if (isCloudConnected && firebaseDb) {
                firebaseDb.ref(`classes/${currentRoomId}/tasks`).set(tasks);
            }
        }

        function savePersonalTurnIns() {
            localStorage.setItem('tpb73_personal_turnins', JSON.stringify(personalTurnIns));
            // Push progress to cloud linked to Student ID
            if (isCloudConnected && firebaseDb) {
                firebaseDb.ref(`classes/${currentRoomId}/students/${studentId}/progress`).set(personalTurnIns);
            }
        }

        function togglePersonalTurnIn(taskId) {
            personalTurnIns[taskId] = !personalTurnIns[taskId];
            savePersonalTurnIns(); // Saves locally & Pushes to Cloud for Cross-Device Sync

            const task = tasks.find(t => t.id === taskId);
            if (task && task.type === 'assignment' && personalTurnIns[taskId]) {
                confetti({ particleCount: 30, spread: 40, origin: { y: 0.7 }});
                showToast('✨ Status Tersimpan ke Cloud!');
            }
            renderDashboard();
        }

        // --- UI & LAYOUT FUNCTIONALITIES --- //

        function loadTasksFromStorage() {
            const saved = localStorage.getItem('tpb73_tasks_v2');
            tasks = saved ? JSON.parse(saved) : INITIAL_MOCK_TASKS;
        }

        function loadPersonalTurnIns() {
            const saved = localStorage.getItem('tpb73_personal_turnins');
            personalTurnIns = saved ? JSON.parse(saved) : {};
        }

        function updateCloudBadgeUI(connected) {
            const badge = document.getElementById('cloud-status-badge');
            const headerBadge = document.getElementById('header-sync-status');
            const headerText = document.getElementById('header-sync-text');

            if (connected) {
                if (badge) badge.className = "brutal-badge bg-emerald-400 text-black text-[10px]";
                if (headerBadge) headerBadge.className = "brutal-badge bg-black text-[#FFE600] px-3 py-1.5 text-[11px] flex items-center gap-2 cursor-pointer hover:bg-slate-800";
                if (headerText) headerText.innerText = "REALTIME SYNCED";
            } else {
                if (badge) badge.className = "brutal-badge bg-slate-200 text-black text-[10px]";
                if (headerBadge) headerBadge.className = "brutal-badge bg-red-600 text-white px-3 py-1.5 text-[11px] flex items-center gap-2 cursor-pointer";
                if (headerText) headerText.innerText = "LOCAL MODE";
            }
        }

        function updateLiveClockAndStatus() {
            const clockEl = document.getElementById('live-time-clock');
            if (clockEl) clockEl.innerText = new Date().toLocaleTimeString('id-ID') + ' WIB';
            renderDashboard(false);
        }

        // --- DASHBOARD RENDERER (Responsive Grid) --- //

        function renderDashboard(fullRefresh = true) {
            if (fullRefresh) updateCourseOptionsDropdown();
            updateCountsAndStats();

            const container = document.getElementById('task-list-container');
            const emptyState = document.getElementById('empty-state');
            const filteredTasks = getFilteredTasks();

            container.innerHTML = '';
            if (filteredTasks.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                filteredTasks.forEach(task => {
                    container.appendChild(createTaskCardElement(task));
                });
            }
            renderUrgentRadar();
            lucide.createIcons();
        }

        function createTaskCardElement(task) {
            const card = document.createElement('div');
            const now = new Date();
            const deadlineDate = task.deadline ? new Date(task.deadline) : null;
            const isExpired = deadlineDate && deadlineDate < now;
            const msLeft = deadlineDate ? deadlineDate - now : 0;
            const hoursLeft = msLeft / (1000 * 3600);
            
            const isUrgent = !isExpired && task.type === 'assignment' && hoursLeft <= 24;
            const isTurnedInByMe = !!personalTurnIns[task.id];

            let cardClasses = "brutal-card p-4 md:p-5 relative overflow-hidden transition-all flex flex-col h-full ";
            
            if (isTurnedInByMe) cardClasses += "task-completed-card ";
            else if (isExpired) cardClasses += "bg-slate-200 border-slate-600 opacity-80 ";
            else if (isUrgent) cardClasses += "bg-[#FF0033] text-white border-black ";
            else cardClasses += "bg-white text-black border-black ";

            card.className = cardClasses;

            let deadlineHtml = '';
            if (task.type === 'assignment' && deadlineDate) {
                const formattedDate = deadlineDate.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
                const hrs = Math.floor(msLeft / (1000 * 3600));
                
                deadlineHtml = `
                    <div class="mt-auto pt-3 border-t-2 ${isUrgent ? 'border-white/30' : 'border-black/10'}">
                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                            <div class="flex items-center gap-1.5 font-bold truncate">
                                <i data-lucide="clock" class="w-4 h-4 shrink-0"></i> ${isExpired ? 'BERAKHIR' : formattedDate}
                            </div>
                            ${!isExpired ? `<span class="bg-black text-[#FFE600] px-2 py-1 rounded font-black text-[10px] animate-pulse">SISA ${hrs} JAM</span>` : ''}
                        </div>
                    </div>
                `;
            }

            card.innerHTML = `
                <div class="flex justify-between items-start gap-3 mb-3">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="brutal-badge bg-black text-white">${task.course}</span>
                    </div>
                    ${currentRole === 'pj' ? `
                        <button onclick="deleteTask('${task.id}')" class="text-black hover:text-red-500 bg-white rounded p-1 border-2 border-black" title="Hapus">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    ` : ''}
                </div>
                
                <h3 class="text-base md:text-lg font-grotesk font-black leading-tight mb-2 flex-grow">
                    ${task.title}
                </h3>

                ${task.type === 'assignment' ? `
                    <button onclick="togglePersonalTurnIn('${task.id}')" class="brutal-btn ${isTurnedInByMe ? 'bg-emerald-400 text-black' : (isUrgent ? 'bg-[#FFE600] text-black' : 'bg-black text-white')} w-full py-2 mb-3 text-xs md:text-sm rounded-xl transition-all">
                        <i data-lucide="${isTurnedInByMe ? 'check-circle-2' : 'circle'}" class="w-4 h-4 stroke-[3]"></i>
                        <span>${isTurnedInByMe ? 'SELESAI (SYNCED)' : 'TANDAI SELESAI'}</span>
                    </button>
                ` : ''}

                ${deadlineHtml}
            `;
            return card;
        }

        // --- SYSTEM UTILS (Filter, Modal, Role, Setup) --- //

        function getFilteredTasks() {
            const query = (document.getElementById('search-input')?.value || '').toLowerCase();
            const course = document.getElementById('filter-course')?.value || 'ALL';
            const sort = document.getElementById('sort-order')?.value || 'deadline-asc';
            const now = new Date();

            let filtered = tasks.filter(t => {
                const match = t.title.toLowerCase().includes(query) || t.course.toLowerCase().includes(query);
                if (!match || (course !== 'ALL' && t.course !== course)) return false;

                const d = t.deadline ? new Date(t.deadline) : null;
                const isExp = d && d < now;
                const hrLeft = d ? (d - now) / 3600000 : 999;

                if (currentTab === 'upcoming') return t.type === 'assignment' && !isExp;
                if (currentTab === 'urgent') return t.type === 'assignment' && !isExp && hrLeft <= 24;
                if (currentTab === 'announcement') return t.type === 'announcement';
                return true; // 'all'
            });

            return filtered.sort((a, b) => {
                if (!a.deadline) return 1; if (!b.deadline) return -1;
                return sort === 'deadline-desc' ? new Date(b.deadline) - new Date(a.deadline) : new Date(a.deadline) - new Date(b.deadline);
            });
        }

        function updateCountsAndStats() {
            const now = new Date();
            let totalA = 0, myDone = 0, urgentC = 0, upC = 0;

            tasks.forEach(t => {
                if (t.type === 'assignment') {
                    totalA++;
                    if (personalTurnIns[t.id]) myDone++;
                    if (t.deadline && new Date(t.deadline) > now) {
                        upC++;
                        if ((new Date(t.deadline) - now) / 3600000 <= 24) urgentC++;
                    }
                }
            });

            const p = totalA > 0 ? Math.round((myDone / totalA) * 100) : 100;
            document.getElementById('personal-progress-percent').innerText = `${p}%`;
            document.getElementById('personal-progress-bar-fill').style.width = `${p}%`;
            
            document.getElementById('mobile-stat-upcoming').innerText = upC;
            document.getElementById('mobile-stat-urgent').innerText = urgentC;
            document.getElementById('mobile-stat-progress').innerText = `${p}%`;
        }

        function renderUrgentRadar() {
            const container = document.getElementById('urgent-radar-list');
            const now = new Date();
            const urgents = tasks.filter(t => t.type === 'assignment' && t.deadline && (new Date(t.deadline) - now) / 3600000 > 0 && (new Date(t.deadline) - now) / 3600000 <= 24).sort((a,b) => new Date(a.deadline) - new Date(b.deadline));
            
            container.innerHTML = '';
            if(!urgents.length) {
                container.innerHTML = `<div class="bg-black/20 p-3 rounded-xl text-center text-xs font-bold text-white"><i data-lucide="shield-check" class="inline w-4 h-4 text-emerald-400"></i> Aman, tidak ada Kritis</div>`;
            } else {
                urgents.slice(0,3).forEach(t => {
                    const hrs = Math.floor((new Date(t.deadline) - now) / 3600000);
                    container.innerHTML += `<div class="bg-black text-white p-3 rounded-xl border-2 border-black flex justify-between items-center"><div class="truncate pr-2"><div class="text-[10px] text-[#FFE600] font-mono">${t.course}</div><div class="text-sm font-bold truncate">${t.title}</div></div><span class="bg-[#FF0033] px-2 py-1 rounded text-[10px] font-black shrink-0 animate-pulse">${hrs} JAM</span></div>`;
                });
            }
        }

        function filterByTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.replace('bg-[#FFE600]', 'bg-white'));
            document.getElementById(`tab-${tab}`).classList.replace('bg-white', 'bg-[#FFE600]');
            renderDashboard(false);
        }

        function openModal() { document.getElementById('modal-backdrop').classList.remove('hidden'); }
        function closeModal() { document.getElementById('modal-backdrop').classList.add('hidden'); }
        function requestPJMode() { document.getElementById('passcode-modal-backdrop').classList.remove('hidden'); }
        function closePasscodeModal() { document.getElementById('passcode-modal-backdrop').classList.add('hidden'); }
        function setRole(r) { currentRole = r; document.getElementById('btn-create-task').classList.toggle('hidden', r!=='pj'); document.getElementById('mobile-nav-add-btn').classList.toggle('hidden', r!=='pj'); renderDashboard(); }
        function verifyPJPin() { if(document.getElementById('input-pj-pin').value === '1234') { closePasscodeModal(); setRole('pj'); showToast('🔑 Akses PJ Terbuka'); } else showToast('❌ PIN Salah'); }
        function setFormType(t) { formType = t; document.getElementById('deadline-fields').classList.toggle('hidden', t!=='assignment'); }
        function openShareModal() { document.getElementById('share-modal-backdrop').classList.remove('hidden'); switchShareTab('cloud'); }
        function closeShareModal() { document.getElementById('share-modal-backdrop').classList.add('hidden'); }
        function switchShareTab(t) { ['cloud', 'qr'].forEach(id => { document.getElementById(`share-tab-${id}`).classList.toggle('hidden', id!==t); document.getElementById(`share-tab-btn-${id}`).classList.toggle('bg-[#FFE600]', id===t); document.getElementById(`share-tab-btn-${id}`).classList.toggle('bg-white', id!==t); }); }
        function showToast(m) { const t=document.getElementById('toast'); document.getElementById('toast-message').innerText=m; t.classList.remove('-translate-y-32'); setTimeout(()=>t.classList.add('-translate-y-32'), 3000); }
        function updateCourseOptionsDropdown() { const s = document.getElementById('filter-course'); const cur = s.value; s.innerHTML = '<option value="ALL">Semua Mata Kuliah TPB</option>'; [...new Set(tasks.map(t=>t.course))].forEach(c => s.innerHTML += `<option value="${c}">${c}</option>`); s.value = cur; }
        
        function handleFormSubmit(e) {
            e.preventDefault();
            const t = {
                id: 'task-'+Date.now(), type: formType,
                title: document.getElementById('input-title').value,
                course: document.getElementById('input-course').value,
                pjName: document.getElementById('input-pj').value || 'PJ',
                deadline: formType==='assignment' ? new Date(document.getElementById('input-deadline').value).toISOString() : null,
                priority: document.getElementById('input-priority').value,
                desc: document.getElementById('input-desc').value
            };
            tasks.unshift(t); pushTasksToCloud(); closeModal(); renderDashboard(); showToast('🚀 Tugas Disebarkan');
        }
        function deleteTask(id) { tasks = tasks.filter(t=>t.id!==id); pushTasksToCloud(); renderDashboard(); showToast('🗑️ Tugas Dihapus'); }
    </script>
</body>
</html>
