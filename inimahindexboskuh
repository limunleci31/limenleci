    <!-- Google Fonts: Space Grotesk, Plus Jakarta Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;800&family=Plus+Jakarta+Sans:ital,wght@0,500;0,700;0,800;1,600&family=Space+Grotesk:wght@700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand-yellow: #FFE600;
            --brand-red: #FF0033;
            --brand-black: #0F0F0F;
            --brand-white: #FFFFFF;
        }

        * {
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F8F5;
            color: var(--brand-black);
            background-image: 
                radial-gradient(var(--brand-black) 1px, transparent 1px),
                linear-gradient(to right, rgba(15, 15, 15, 0.02) 1px, transparent 1px);
            background-size: 20px 20px;
            /* Safe area for mobile notch/home bar */
            padding-bottom: env(safe-area-inset-bottom);
        }

        .font-grotesk { font-family: 'Space Grotesk', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        /* Neo-Brutalist Responsive Classes */
        .brutal-card {
            background-color: var(--brand-white);
            border: 3px solid var(--brand-black);
            box-shadow: 4px 4px 0px var(--brand-black);
            border-radius: 16px;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
        }

        /* Desktop optimizations */
        @media (min-width: 1024px) {
            .brutal-card {
                border-width: 3.5px;
                box-shadow: 6px 6px 0px var(--brand-black);
            }
            .brutal-card:hover {
                transform: translateY(-2px);
                box-shadow: 8px 8px 0px var(--brand-black);
            }
        }

        .brutal-btn {
            border: 2.5px solid var(--brand-black);
            box-shadow: 3px 3px 0px var(--brand-black);
            font-weight: 800;
            transition: all 0.15s ease-out;
            user-select: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            cursor: pointer;
            min-height: 44px; /* Better touch target for mobile */
        }

        @media (min-width: 768px) {
            .brutal-btn {
                min-height: 38px; /* Standard for desktop */
                border-width: 3px;
                box-shadow: 4px 4px 0px var(--brand-black);
            }
            .brutal-btn:hover {
                transform: translate(-2px, -2px);
                box-shadow: 6px 6px 0px var(--brand-black);
            }
        }

        .brutal-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0px var(--brand-black);
        }

        .brutal-badge {
            border: 2px solid var(--brand-black);
            font-weight: 800;
            border-radius: 8px;
            text-transform: uppercase;
            font-size: clamp(0.65rem, 1.5vw, 0.75rem); /* Fluid text scaling */
            letter-spacing: 0.04em;
            padding: 0.25rem 0.6rem;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            white-space: nowrap;
        }

        .brutal-input {
            border: 2.5px solid var(--brand-black);
            box-shadow: 3px 3px 0px var(--brand-black);
            border-radius: 12px;
            font-weight: 700;
            transition: all 0.15s ease;
        }

        .brutal-input:focus {
            box-shadow: 5px 5px 0px var(--brand-black);
            outline: none;
            background-color: #FFFDF0;
        }

        .task-completed-card {
            border-color: #059669 !important;
            background-color: #ECFDF5 !important;
        }

        /* Mobile Bottom Sheet Modal Styling */
        @media (max-width: 767px) {
            .modal-content-container {
                border-bottom-left-radius: 0 !important;
                border-bottom-right-radius: 0 !important;
                border-top-left-radius: 24px !important;
                border-top-right-radius: 24px !important;
                max-height: 85vh !important;
                padding-bottom: calc(1.5rem + env(safe-area-inset-bottom)) !important;
            }
        }

        /* Minimalist Widget Mode Styles */
        body.widget-mode {
            background: #0f172a;
            background-image: none;
            color: #f8fafc;
        }

        body.widget-mode header,
        body.widget-mode footer,
        body.widget-mode .mobile-nav-bar,
        body.widget-mode .non-widget-element {
            display: none !important;
        }

        .widget-container { display: none; }
        body.widget-mode .widget-container { display: block; }

        /* Custom Scrollbar */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #F1F1F1; border-left: 2px solid var(--brand-black); }
        ::-webkit-scrollbar-thumb { background: var(--brand-yellow); border: 2px solid var(--brand-black); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--brand-red); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased pb-20 md:pb-0">

