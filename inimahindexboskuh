                </div>
            </div>
        </div>

        <!-- Grid Layout Adjustments: Desktop 8/4 or 9/3 ratio -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
            
            <!-- MAIN CONTENT COLUMN (DESKTOP: 8/12, MOBILE: 100%) -->
            <div class="lg:col-span-8 xl:col-span-9 space-y-4 md:space-y-6">
                
                <!-- SEARCH & TAB FILTER BOARD -->
                <div class="brutal-card p-4 sm:p-5 md:p-6 bg-white space-y-4">
                    
                    <div class="relative">
