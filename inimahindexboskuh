                    <span id="header-sync-text">REALTIME SYNCED</span>
                </div>

                <button onclick="downloadAllICS()" class="brutal-btn bg-white text-black hover:bg-slate-100 px-3 py-1.5 text-xs rounded-xl" title="Ekspor File Kalender (.ics)">
