                <button onclick="openShareModal()" class="brutal-btn bg-white text-black hover:bg-yellow-200 px-3 py-1.5 text-xs rounded-xl">
                    <i data-lucide="cloud" class="w-4 h-4 text-black"></i>
                    <span>Cloud Sync</span>
                </button>

                <button onclick="toggleWidgetMode(true)" class="brutal-btn bg-black text-white hover:bg-slate-800 px-3 py-1.5 text-xs rounded-xl">
                    <i data-lucide="layout-grid" class="w-4 h-4 text-[#FFE600]"></i>
                </button>
            </div>

        </div>
    </header>

    <!-- REALTIME CONNECTION BANNER (Device Sync Info) -->
    <div class="bg-black text-white py-2 px-4 border-b-4 border-black relative overflow-hidden non-widget-element">
